; home'e.g
; called to home the e axis
;
; generated by RepRapFirmware Configuration Tool v3.5.5 on Sun Nov 17 2024 19:52:57 GMT-0700 (Mountain Standard Time)

; increase Z
G91 ; relative positioning
G1 H2 Z5 ; move Z relative to current position to avoid dragging nozzle over the bed
G90 ; absolute positioning

; home e
G91 ; relative positioning
var maxTravel = move.axes[7].max - move.axes[7].min + 5 ; calculate how far e can travel plus 5mm
G1 H1 'e{-var.maxTravel} F600 ; coarse home in the -e direction
G1 'e5 F6000 ; move back 5mm
G1 H1 'e{-var.maxTravel} F300 ; fine home in the -e direction
G90 ; absolute positioning

; decrease Z again
G91 ; relative positioning
G1 H2 Z-5 F6000 ; move Z relative to current position
G90 ; absolute positioning
