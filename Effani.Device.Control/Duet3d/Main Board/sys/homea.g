; homea.g
; called to home the A axis
;
; generated by RepRapFirmware Configuration Tool v3.5.6 on Mon Nov 25 2024 16:23:33 GMT-0700 (Mountain Standard Time)

; increase Z
G91 ; relative positioning
G1 H2 Z5 ; move Z relative to current position to avoid dragging nozzle over the bed
G90 ; absolute positioning

; home A
G91 ; relative positioning
var maxTravel = move.axes[6].max - move.axes[6].min + 5 ; calculate how far A can travel plus 5mm
G1 H1 A{-var.maxTravel} F600 ; coarse home in the -A direction
G1 A5 F6000 ; move back 5mm
G1 H1 A{-var.maxTravel} F300 ; fine home in the -A direction
G90 ; absolute positioning

; decrease Z again
G91 ; relative positioning
G1 H2 Z-5 F6000 ; move Z relative to current position
G90 ; absolute positioning
