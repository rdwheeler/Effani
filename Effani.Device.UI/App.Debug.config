<?xml version="1.0" encoding="utf-8"?>
<!--For more information on using transformations see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<appSettings>
		<add key="StandardsProcessingDwell" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="BasalIncubationTimerPeriod" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="NadhReadingsTimerPeriod" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="NadhReading1TimerPeriod" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="KohTimerPeriod" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="DnaTimerPeriod" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="TimerDescriptionUpdateInterval" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="TraySterilizationTime" value="1" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="SensorReadDwell" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="BypassDeviceCommands" value="0" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="PauseCommandsForPrompt" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="EffaniApiUrl" value="https://localhost:44384/umbraco/api" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
</configuration>