<?xml version="1.0" encoding="utf-8"?>
<!--For more information on using transformations see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<appSettings>
		<add key="TestMediaTimerPeriod" value="150000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
		<!--<add key="TestMediaTimerPeriod" value="900000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>-->
	</appSettings>
	<appSettings>
		<add key="BaselineProcessingDwell" value="6000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
		<!--<add key="BaselineProcessingDwell" value="60000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>-->
	</appSettings>
	<appSettings>
		<add key="KohTimerPeriod" value="300000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="DnaTimerPeriod" value="300000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="TerminateOnSensorFailure" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="BypassDeviceCommands" value="0" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="wifi-ssid" value="blah - 2.4Ghz" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="wifi-password" value="B4forever!" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
</configuration>