<?xml version="1.0" encoding="utf-8"?>
<!--For more information on using transformations see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<appSettings>
		<add key="StandardsProcessingDwell" value="3000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="BasalIncubationTimerPeriod" value="60000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="NadhReadingsTimerPeriod" value="60000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="KohTimerPeriod" value="60000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="DnaTimerPeriod" value="60000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="TimerDescriptionUpdateInterval" value="1000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="OpticalSensorDwell" value="3000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="BypassDeviceCommands" value="0" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="wifi-ssid" value="blah - 2.4Ghz" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
	<appSettings>
		<add key="wifi-password" value="B4forever!" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
	</appSettings>
</configuration>