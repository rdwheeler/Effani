                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Current (mA)" ToolTip="RMS motor current for the NADH pump motor in mA (M906).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhMotorCurrent}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Max Speed (mm/min)" ToolTip="Maximum speed of the NADH pump axis (M203).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhMaxSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Acceleration (mm/s²)" ToolTip="Acceleration of the NADH pump axis (M201).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhAcceleration}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Max Speed Change (mm/min)" ToolTip="Maximum instantaneous speed change (jerk) of the NADH pump axis (M566).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhMaxInstantaneousSpeedChange}" />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup View="GroupBox" Header="Basal" Orientation="Vertical">
                                    <dxlc:LayoutItem Label="Steps per mm" ToolTip="Motor steps (including 16x microstepping) per mm of Basal pump travel. Written to config.g with M92. For a 1.8 degree motor with a 2.54 mm lead screw: 200 x 16 / 2.54 = 1259.84.">
                                        <dxe:SpinEdit IsFloatValue="True" EditValueType="{x:Type sys:Decimal}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalStepsPerMillimeter}" />
