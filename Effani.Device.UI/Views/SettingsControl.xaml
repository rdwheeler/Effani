<UserControl 
    x:Class="Effani.Device.UI.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:control="clr-namespace:Drivetrain.Robotics.Control;assembly=Drivetrain.Robotics.Control"
    xmlns:local="clr-namespace:Effani.Device.UI"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
	d:DataContext="{d:DesignInstance Type=local:UtilitiesViewModel}"
    mc:Ignorable="d" d:DesignHeight="1024" d:DesignWidth="1980">
    <UserControl.Resources>
        <SolidColorBrush  x:Key="LevelOneColor" Color="#efefef"/>
        <SolidColorBrush  x:Key="LevelTwoColor" Color="#dfdfdf"/>
        <SolidColorBrush  x:Key="LevelThreeColor" Color="#d0d0d0"/>
        <Style TargetType="GroupBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style TargetType="dxlc:LayoutItemLabel">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="dxlc:LayoutItem">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="LabelPosition" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="dxlc:LayoutGroup">
            <Setter Property="ItemSpace" Value="10"/>
            <Setter Property="IsCollapsible" Value="True"/>
        </Style>
        <Style TargetType="dxe:SpinEdit" >
            <Setter Property="MaxWidth" Value="80"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- settings the device control reads while running: locked, with an explanation, while an assay is running -->
        <Style x:Key="DeviceControlSetting" TargetType="dxe:SpinEdit" BasedOn="{StaticResource {x:Type dxe:SpinEdit}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=DataContext.IsAssayRunning, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="This setting is in use by the device control while an assay is running, so it cannot be changed until the assay is finished or canceled."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="dxlc:GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TitleBackground" Value="Gray"/>
            <Setter Property="TitleForeground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource LevelTwoColor}"/>
        </Style>
        <Style x:Key="tertiaryGroupBox" TargetType="dxlc:GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TitleBackground" Value="#b1b1b1"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource LevelThreeColor}"/>
        </Style>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxwui:WinUIDialogService>
            <dxwui:WinUIDialogService.ViewTemplate>
                <DataTemplate>
                    <dxlc:LayoutItem Label="How would you like to describe these settings?" LabelPosition="Top">
                        <dxe:TextEdit NullText="Settings Description" EditValue="{Binding NewSettingsDescription}"/>
                    </dxlc:LayoutItem>
                </DataTemplate>
            </dxwui:WinUIDialogService.ViewTemplate>
        </dxwui:WinUIDialogService>
    </dxmvvm:Interaction.Behaviors>
    <DockPanel LastChildFill="True" Background="{StaticResource LevelOneColor}">
        <StackPanel HorizontalAlignment="Left" DockPanel.Dock="Top" Margin="20,20,0,0">
            <Label Content="Active Settings" />
            <StackPanel Orientation="Horizontal">
                <dxe:ComboBoxEdit
					FontSize="15" MinWidth="200"
					ItemsSource="{Binding SettingsVersions}"
					DisplayMember="Description"
					IsTextEditable="False"
					EditValue="{Binding ActiveSettingsVersion, Mode=OneWay}"
					SelectedIndexChanged="ComboBoxEdit_SelectedIndexChanged">
                    <dxe:ComboBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:SimpleButton HorizontalAlignment="Left" Margin="0" Padding="0" BorderThickness="0" Width="20" 
												 ToolTip="{DXBinding '@a($dxe:ComboBoxEdit).DataContext.ActiveSettingsVersion != @c ? `Delete these settings` : `Active settings cannot be deleted`'}" 
												 IsEnabled="{DXBinding '@a($dxe:ComboBoxEdit).DataContext.ActiveSettingsVersion != @c'}">
                                    <dx:SimpleButton.Content>
                                        <Image Source="{dx:DXImage 'SvgImages/Dashboards/Delete.svg'}" />
                                    </dx:SimpleButton.Content>
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:ConfirmationBehavior 
											EnableConfirmationMessage="True"
											Command="{Binding Path=DataContext.DeleteSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type dxe:ComboBoxEdit}}}"
											CommandParameter="{Binding}"
											MessageText="{DXBinding '`Are you sure to delete the &quot;` + @c.Description + `&quot; settings?`'}"  
											MessageIcon="Question" MessageTitle="Delete Settings"/>
                                    </dxmvvm:Interaction.Behaviors>
                                </dx:SimpleButton>
                                <TextBlock FontSize="15" Text="{Binding Description}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dxe:ComboBoxEdit.ItemTemplate>
                </dxe:ComboBoxEdit>
                <dx:SimpleButton Margin="5,0,0,0" CornerRadius="5" Width="40" Padding="3" Background="AliceBlue" Height="40" ToolTip="Save these settings as..." Command="{Binding SaveActiveSettingsAsNewVersionCommand}">
                    <dx:SimpleButton.Content>
                        <Image Source="{dx:DXImage 'SvgImages/Save/SaveDialog.svg'}" />
                    </dx:SimpleButton.Content>
                </dx:SimpleButton>
                <dx:SimpleButton Margin="5,0,0,0" Glyph="../resources/Reset.svg" CornerRadius="5" Width="40" Padding="3" Background="AliceBlue" Height="40" ToolTip="Reset settings to their default values." Command="{Binding ResetActiveSettingsCommand}"/>
                <!--<dx:SimpleButton Margin="5,0,0,0" Glyph="../resources/Upload.svg" CornerRadius="5" Width="40" Padding="3" Background="AliceBlue" Height="40" ToolTip="Upload these settings to the cloud" Command="{Binding UploadSettingsCommand}"/>
                <dx:SimpleButton Margin="5,0,0,0" Glyph="../resources/Download.svg" CornerRadius="5" Width="40" Padding="3" Background="AliceBlue" Height="40" ToolTip="Download these settings from the cloud" Command="{Binding DownloadSettingsCommand}"/>-->
            </StackPanel>
        </StackPanel>
        <dx:DXTabControl Margin="20,20,0,0" DataContext="{Binding Path=Settings}">
            <dx:DXTabItem Header="Fluid Emission">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup>
                    <dxlc:FlowLayoutControl Orientation="Horizontal" ItemSpace="10">
                        <dxlc:LayoutGroup View="GroupBox" Header="Emission Volumes (μl)" ToolTip="Fluid volume dispensed to a sample well" Orientation="Vertical" >
                            <dxlc:LayoutItem Label="NADH">
                                <dxe:SpinEdit EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding NadhVolume}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="DNA Reagent">
                                <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding DnaVolume}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="KOH">
                                <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding KohVolume}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Basal Media">
                                <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding BasalVolume}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Priming Volumes (μl)" Orientation="Horizontal">
                            <dxlc:LayoutGroup View="GroupBox" Header="Initial Priming" ToolTip="Volume dispensed during first pump priming" Orientation="Vertical" GroupBoxStyle="{StaticResource tertiaryGroupBox}">
                                <dxlc:LayoutItem Label="NADH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialNadhFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="DNA Reagent">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialDnaFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="KOH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialKohFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Basal Media">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialBasalFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup View="GroupBox" Header="Secondary Priming" ToolTip="Volume dispensed during second pump priming" Orientation="Vertical" GroupBoxStyle="{StaticResource tertiaryGroupBox}">
                                <dxlc:LayoutItem Label="NADH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryNadhFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="DNA Reagent">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryDnaFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="KOH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryKohFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Basal Media">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryBasalFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Reprime Pump Interval (min)">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="600" EditValue="{Binding ReprimePumpInterval}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Syringe Travel (mm/μl)" Orientation="Vertical">
                            <dxlc:LayoutItem Label="NADH" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding NadhTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="DNA Reagent" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding DnaTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="KOH" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding KohTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Basal Media" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding BasalTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Syringe Loading Positions (mm from 0)" Orientation="Vertical">
                            <dxlc:LayoutItem Label="NADH" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding NadhSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="DNA Reagent" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding DnaSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="KOH" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding KohSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Basal Media" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding BasalSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Emission Speed" Orientation="Vertical">
                            <dxlc:LayoutItem Label="Fluid Syringe Speed (mm/s)" ToolTip="Speed at which a fluid syringe should travel">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding FluidSyringeSpeed}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Fluid Emission Pause (ms)" ToolTip="Milliseconds to wait before moving after dispensing fluid">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding FluidEmissionDwell}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                    </dxlc:FlowLayoutControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Component Properties">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Fluid Port Locations" Orientation="Vertical">
                        <dxlc:LayoutItem LabelPosition="Top" Label="NADH" ToolTip="Platform coordinates (mm x mm) of the location at which NADH is emitted">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding NadhLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding NadhLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="DNA Reagent" ToolTip="Platform coordinates (mm x mm) of the location at which DNA Reagent is emitted">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding DnaLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding DnaLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="KOH" ToolTip="Platform coordinates (mm x mm) of the location at which KOH is emitted">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding KohLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding KohLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Basal Media" ToolTip="Platform coordinates (mm x mm) of the location at which Basal Media is emitted">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding BasalLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding BasalLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="KOH Aspiration" ToolTip="Platform coordinates (mm x mm) of the location at which KOH is aspirated">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding AspirateLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding AspirateLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Sensor Locations" Orientation="Vertical">
                        <dxlc:LayoutItem LabelPosition="Top" Label="DNA" ToolTip="Platform coordinates (mm x mm) of the location at which DNA readings are taken">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding DnaSensorLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding DnaSensorLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="NADH" ToolTip="Platform coordinates (mm x mm) of the location at which NADH readings are taken">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding NadhSensorLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding NadhSensorLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Tray Carrier Locations" Orientation="Vertical">
                        <dxlc:LayoutItem LabelPosition="Top" Label="First Well Location" ToolTip="Platform coordinates (mm x mm) of the location of the lower left corner of the first sample well">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding FirstWellLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding FirstWellLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Tray Loading Location" ToolTip="Platform coordinates (mm x mm) of the location at which sample trays are loaded">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TrayLoadingLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TrayLoadingLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Sample Tray Properties" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Well Width" ToolTip="Width (mm) of a sample well">
                            <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0.01" MaxValue="100" EditValue="{Binding WellWidth}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Well Depth" ToolTip="Depth (mm) of a sample well">
                            <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0.01" MaxValue="100" EditValue="{Binding WellDepth}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Vertical Well Count" ToolTip="Count of sample wells in a tray in the vertical direction">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="1" MaxValue="100" EditValue="{Binding VerticalWellCount}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Horizontal Well Count" ToolTip="Count of sample wells in a tray in the horizontal direction">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="1" MaxValue="100" EditValue="{Binding HorizontalWellCount}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Tray Offset (mm)" ToolTip="Distance from well 0 of a tray to well 0 of the next tray">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding PlateOffsetX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding PlateOffsetY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Well Offset (mm)" ToolTip="Distance between sample wells">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding WellOffsetX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding WellOffsetY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Aspiration Pump Properties" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Aspirate Needle Start Position" ToolTip="The starting position (mm) of a the KOH aspiration needle">
                            <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding AspirateActuatorStartPosition}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Aspirate Distrance to Tray" ToolTip="The distance (mm) between the tip of the KOH aspiration needle and the top of the sample tray">
                            <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="100" EditValue="{Binding AspirateDistanceToPlate}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Aspirate Travel Per Microliter" ToolTip="The distance (mm) the aspiration needle travels in order to remove 1μl">
                            <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="100" EditValue="{Binding AspirateTravelPerMicroLiter}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Aspirate Positioning Speed (mm/min)" ToolTip="Speed (mm/min) at which the aspiration needle moves to the sample tray before aspirating">
                            <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding AspiratePositioningSpeed}" />
                        </dxlc:LayoutItem>                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Electronic Settings">
                <dxlc:LayoutControl Orientation="Horizontal" Name="main">
                    <dxlc:LayoutControl Orientation="Vertical">
                        <dxlc:LayoutGroup View="GroupBox" Header="Controller Boards" Orientation="Vertical">
                            <dxlc:LayoutItem Label="Board Count" ToolTip="Number of controller boards installed (board 0 is the main board). Used to warn about connections to boards that do not exist.">
                                <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="10" EditValue="{Binding ControllerBoardCount}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Input Ports Per Board" ToolTip="Number of IO input ports on each board (io0.in to io{N-1}.in). Used to warn about endstops on ports that do not exist.">
