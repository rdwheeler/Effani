                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup View="GroupBox" Header="KOH" Orientation="Vertical">
                                    <dxlc:LayoutItem Label="Steps per mm" ToolTip="Motor steps (including 16x microstepping) per mm of KOH pump travel. Written to config.g with M92. For a 1.8 degree motor with a 2.54 mm lead screw: 200 x 16 / 2.54 = 1259.84.">
                                        <dxe:SpinEdit IsFloatValue="True" EditValueType="{x:Type sys:Decimal}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohStepsPerMillimeter}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Travel (mm)" ToolTip="Usable travel of the KOH pump actuator in mm (upper limit of M208). Homing distance is based on this, so keep it below the actuator's stroke.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohTravelLength}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Current (mA)" ToolTip="RMS motor current for the KOH pump motor in mA (M906).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohMotorCurrent}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Max Speed (mm/min)" ToolTip="Maximum speed of the KOH pump axis (M203).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohMaxSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Acceleration (mm/s²)" ToolTip="Acceleration of the KOH pump axis (M201).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohAcceleration}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Max Speed Change (mm/min)" ToolTip="Maximum instantaneous speed change (jerk) of the KOH pump axis (M566).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohMaxInstantaneousSpeedChange}" />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup View="GroupBox" Header="NADH" Orientation="Vertical">
                                    <dxlc:LayoutItem Label="Steps per mm" ToolTip="Motor steps (including 16x microstepping) per mm of NADH pump travel. Written to config.g with M92. For a 1.8 degree motor with a 2.54 mm lead screw: 200 x 16 / 2.54 = 1259.84.">
                                        <dxe:SpinEdit IsFloatValue="True" EditValueType="{x:Type sys:Decimal}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhStepsPerMillimeter}" />
