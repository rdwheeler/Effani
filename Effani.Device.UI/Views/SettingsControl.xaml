            </dx:DXTabItem>
            <dx:DXTabItem Header="Assay Timing">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Assay Timing (ms)" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Basal Media Incubation (ms)" ToolTip="Milliseconds sample stays in Basal media incubation">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding BasalIncubationTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="NADH-Basal Mixing Period (ms)" ToolTip="Milliseconds to wait for NADH to mix with Basal Media">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding NadhReading1TimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="NADH Readings Interval (ms)" ToolTip="Milliseconds between NADH readings">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding NadhReadingsTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="NADH Timer Period (ms)" ToolTip="Milliseconds sample stays in NADH solution">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding NadhIncubationDwell}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="KOH Timer Period (ms)" ToolTip="Milliseconds sample stays in KOH solution">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding KohTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="DNA Reagent Timer Period (ms)" ToolTip="Milliseconds sample stays in DNA reagent">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding DnaTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Standards Establishment Period (seconds)" ToolTip="Milliseconds taken for establishing standards">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding StandardsProcessingDwell}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Aspiration Dwell (ms)" ToolTip="Milliseconds to wait after lowering the aspiration needle into the sample">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding AspirationDwell}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Sensor Read Pause (ms)" ToolTip="Milliseconds to wait before taking a DNA or NADH sensor reading">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding SensorReadDwell}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Sterilization">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Sample Tray Sterilization" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Tray Sterilization Time (seconds)" ToolTip="Number of seconds tray will be UV sterilized">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding TraySterilizationTime}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Tray Sterilization Location" ToolTip="Platform coordinates (mm x mm) of the location at which sample trays are sterilized">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TraySterilizationLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TraySterilizationLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Connectivity">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Connectivity" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Effani API URL" ToolTip="Internet location of the Effani API endpoint.">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding EffaniApiUrl}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Effani Username" ToolTip="Username (email address) of your Effani account.">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding EffaniUsername}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Effani Password" ToolTip="Password of your Effani account.">
                            <dxe:PasswordBoxEdit ShowPasswordButtonVisibility="Auto" MinWidth="300" EditValue="{Binding EffaniPassword}"  />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Controller WiFi" Orientation="Vertical">
                        <dxlc:LayoutItem Label="WiFi SSID" ToolTip="Name of the WiFi network the controller board is configured with (M587).">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding WifiSsid}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="WiFi Password" ToolTip="Password of the WiFi network the controller board is configured with (M587). Stored as plain text.">
                            <dxe:PasswordBoxEdit ShowPasswordButtonVisibility="Auto" MinWidth="300" EditValue="{Binding WifiPassword}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <StackPanel Orientation="Horizontal">
                                <dx:SimpleButton CornerRadius="3" Padding="5,3,5,3" Margin="0,0,5,0" Content="Enable Wifi on Controller" ToolTip="Turns the controller's WiFi on (M552 S1)."
                                                 Command="{Binding Path=DataContext.EnableWifiCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" />
                                <dx:SimpleButton CornerRadius="3" Padding="5,3,5,3" Content="Disable Wifi on Controller" ToolTip="Turns the controller's WiFi off (M552 S0)."
                                                 Command="{Binding Path=DataContext.DisableWifiCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" />
                            </StackPanel>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dx:SimpleButton CornerRadius="3" Padding="5,3,5,3" HorizontalAlignment="Left" Content="Send WiFi Settings" ToolTip="Sends M587 to the controller board with the SSID and password above."
                                             Command="{Binding Path=DataContext.SetWifiCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </DockPanel>
</UserControl>
