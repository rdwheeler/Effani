<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>False</UseWindowsForms>
		<ApplicationIcon>Resources\effanicow.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\effanicow.webp" />
	  <None Remove="Resources\effani_background.jpg" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Resources\effanicow.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DevExpress.Images" Version="24.1.7" />
		<PackageReference Include="DevExpress.Win.Design" Version="24.1.7" />
		<PackageReference Include="DevExpress.Wpf.Core" Version="24.1.7" />
		<PackageReference Include="DevExpress.Wpf.ThemesLW" Version="24.1.7" />
		<PackageReference Include="DevExpress.Mvvm.CodeGenerators" Version="22.1.*-*" />
		<PackageReference Include="DevExpress.Wpf.Controls" Version="24.1.7" />
		<PackageReference Include="DevExpress.Wpf.Reporting" Version="24.1.7" />
		<PackageReference Include="DevExpress.Wpf.Themes.Office2016White" Version="24.1.7" />
		<PackageReference Include="DevExpress.Wpf.Themes.All" Version="24.1.7" />
		<PackageReference Include="DevExpress.Win.BonusSkins" Version="24.1.7" />
		<PackageReference Include="DriveTrain.Toolbox" Version="1.0.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.5" />
		<PackageReference Include="Microsoft.VisualStudio.SlowCheetah" Version="4.0.50">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Drivetrain.Robotics.Control\Drivetrain.Robotics.Control.csproj" />
	  <ProjectReference Include="..\Drivetrain.Robotics.Process\Drivetrain.Robotics.Process.csproj" />
	  <ProjectReference Include="..\Effani.Device.Assay\Effani.Device.Assay.csproj" />
	  <ProjectReference Include="..\Effani.Device.Control\Effani.Device.Control.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\effanicow.webp" />
	  <Resource Include="Resources\effani_background.jpg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
	  <None Update="App.config">
	    <TransformOnBuild>true</TransformOnBuild>
	  </None>
	  <None Update="App.Debug.config">
	    <IsTransformFile>true</IsTransformFile>
	    <DependentUpon>App.config</DependentUpon>
	  </None>
	  <None Update="App.Release.config">
	    <IsTransformFile>true</IsTransformFile>
	    <DependentUpon>App.config</DependentUpon>
	  </None>
	</ItemGroup>

</Project>
