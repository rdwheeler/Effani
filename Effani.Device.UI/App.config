<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System">
			<section name="DevExpress.LookAndFeel.Design.AppSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<applicationSettings>
		<DevExpress.LookAndFeel.Design.AppSettings>
			<setting name="DefaultAppSkin" serializeAs="String">
				<value>Skin/DevExpress Dark Style</value>
			</setting>
			<setting name="DefaultPalette" serializeAs="String">
				<value></value>
			</setting>
			<setting name="TouchUI" serializeAs="String">
				<value></value>
			</setting>
			<setting name="CompactUI" serializeAs="String">
				<value></value>
			</setting>
			<setting name="TouchScaleFactor" serializeAs="String">
				<value></value>
			</setting>
			<setting name="DirectX" serializeAs="String">
				<value></value>
			</setting>
			<setting name="RegisterUserSkins" serializeAs="String">
				<value></value>
			</setting>
			<setting name="RegisterBonusSkins" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="FontBehavior" serializeAs="String">
				<value>UseSegoeUI</value>
			</setting>
			<setting name="DefaultAppFont" serializeAs="String">
				<value></value>
			</setting>
			<setting name="DPIAwarenessMode" serializeAs="String">
				<value></value>
			</setting>
			<setting name="CustomPaletteCollection" serializeAs="Xml">
				<value />
			</setting>
		</DevExpress.LookAndFeel.Design.AppSettings>
	</applicationSettings>
	<appSettings>
		<add key="ComPortNumber" value="4" />
		<add key="FluidSyringeLoadingPosition" value="102" />
		<add key="BypassDeviceCommands" value="0" />
		<add key="PauseCommandsForPrompt" value="false" /> <!--bool: if true the UI will display each command and pause before executing -->
		<add key="TrayTemperature" value="38.777778" />
		<add key="FluidSyringeSpeed" value="5" />
		<add key="TableAxisSpeed" value="4000" /> <!--mm/min at which the X and Y axes move-->

		<add key="AspirateFluidActuatorStartPosition" value="470" />
		<add key="AspirateKohActuatorStartPosition" value="470" />
		<add key="AspirateKohDistanceToPlate" value="14.5" />
		<add key="AspirateFluidDistanceToPlate" value="13.5" />
		<add key="AspiratePositioningSpeed" value="200" />
		<add key="AspirateStirSpeed" value="200" />
		<add key="AspirateTravelPerMicroLiter" value="0.00156" /> <!--decimal: configures how far an aspiration needle desends for each micro liter of fluid aspirated-->
		<add key="FluidTravelPerMicroLiter" value="0.00153" /> <!--decimal: configures how far a fluid pump syringe travels for each micro liter of fluid emitted-->

		<!--component loctions-->
		<add key="AspirateFluidLocation" value="164,207" />
		<add key="AspirateKohLocation" value="326,207" />
		<add key="BiopsyLocation" value="245,110" />
		<add key="DnaLocation" value="329,306" />
		<add key="KohLocation" value="329,256" />
		<add key="NadhLocation" value="163,307" />
		<add key="BasalLocation" value="163,257" />
		<add key="NadhSensorLocation" value="169.5,381" />
		<add key="DnaSensorLocation" value="328,379" />
		<add key="WasteLocation" value="0,0" />
		<add key="FirstWellLocation" value="0,0" />

		<add key="NadhSensorBoardNumber" value="1" />
		<add key="NadhSensorPortNumber" value="6" />
		<add key="NadhSensorNumber" value="1" />
		<add key="NadhSensorReadHigh" value="10000" />
		<add key="NadhSensorReadLow" value="0" />
		<add key="DnaSensorBoardNumber" value="2" />
		<add key="DnaSensorPortNumber" value="6" />
		<add key="DnaSensorNumber" value="0" />
		<add key="DnaSensorReadHigh" value="10000" />
		<add key="DnaSensorReadLow" value="0" />

		<add key="AspirationPressureToggleBoardNumber" value="1" />
		<add key="AspirationPressureTogglePortNumber" value="2" />
		<add key="AspirationPressureDwell" value="2000" /> <!--int: milliseconds the aspiration needle will be pressurized to clear off sample -->
		<add key="AspirationPressureAscension" value="3" />	<!--decimal: millimeters the aspiration needle ascends before being pressurized to clear off sample -->

		<add key="AspirationSuctionToggleBoardNumber" value="1" />
		<add key="AspirationSuctionTogglePortNumber" value="1" />

		<add key="VerticalWellCount" value="12" />
		<add key="HorizontalWellCount" value="8" />
		<add key="StandardsWellCount" value="6" />

		<add key="PlateOffset" value="90,0" />
		<add key="WellOffset" value="9,9" />
		<add key="TraySterilizationTime" value="60000" /> <!--int: configures how many milliseconds the sterilization sequence runs -->
		<add key="InitialFluidPrimingVolume" value="1500" /> <!--decimal: microliters of fluid the large priming step dispenses-->
		<add key="SecondaryFluidPrimingVolume" value="200" /> <!--decimal: microliters of fluid the small priming step dispenses-->
		<add key="DnaVolume" value="200" /> <!--decimal: microliters of DNA reagent dispensed-->
		<add key="NadhVolume" value="300" /> <!--decimal: microliters of NADH dispensed-->
		<add key="KohVolume" value="300" /> <!--decimal: microliters of KOH dispensed-->
		<add key="BasalVolume" value="300" /> <!--decimal: microliters of Basal media dispensed-->
		<add key="TestMediaAspirationVolume" value="350" />	<!--decimal: microliters of fluid aspirated when removing Basal media-->
		<add key="KohAspirationVolume" value="250" /> <!--decimal: microliters of fluid aspirated when removing KOH-->
		<add key="DnaAspirationVolume" value="350" /> <!--decimal: microliters of fluid aspirated when removing DNA reagent-->
		<add key="NadhIncubationDwell" value="60000" /> <!--int: milliseconds to pause after adding NADH before reading-->
		<add key="StandardsProcessingDwell" value="180000" />
		<add key="NadhReadingsTimerPeriod" value="3600000" />
		<add key="BasalIncubationTimerPeriod" value="3600000" />
		<add key="KohTimerPeriod" value="14400000" />
		<add key="DnaTimerPeriod" value="180000" />
		<add key="AspirationDwell" value="15000" /> <!--int: milliseconds an aspiration needle will remain at the bottom of a well before ascending -->
		<add key="FluidEmissionDwell" value="6000" /> <!--int: milliseconds to pause after emitting fluid -->
		<add key="TimerDescriptionUpdateInterval" value="1000" />
		<add key="SensorReadDwell" value="10000" />
		<add key="WellWidth" value="6.67" />
		<add key="WellDepth" value="12" />
		<add key="TrayLoadingLocation" value="0,0" />
		<add key="TraySterilizationLocation" value="320,20" />
	</appSettings>
</configuration>